{
  "name": "ownform-backend",
  "version": "0.1.0",
  "description": "REST API for ownform, the personal growth RPG app",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "migrate": "node --env-file=.env src/db/run-migrations.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U ownform -d ownform",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "Juan Diego Triana",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}