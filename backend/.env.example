# Template for backend/.env. Copy it and replace the values:
#   macOS / Linux / Git Bash:  cp .env.example .env
#   Windows PowerShell:        Copy-Item .env.example .env
# Never commit .env: it holds your real password.

# Used by Docker Compose to create the database the first time the container starts.
POSTGRES_USER=ownform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ownform

# Used by the Node code. The user, password and database must match the three lines above.
# Use only letters, numbers and _ in the password. Characters like @ : / # % break this URL.
DATABASE_URL=postgresql://ownform:CHANGE_ME@localhost:5432/ownform